---
# {{ ansible_managed }}
#
# Les deux namespaces de la Gateway, créés AVANT la configuration : kubectl diff
# ne peut pas simuler la création d'objets dans un namespace qui n'existe pas encore.
#
# Niveau de sécurité « restricted » dans les deux : les pods d'Envoy Gateway le
# respectent (exécution sans root, aucun privilège, capacités retirées, seccomp).
#
# Le namespace du contrôleur d'Envoy Gateway, et des proxys Envoy qu'il crée pour
# chaque Gateway. Déclaré ici plutôt que pris dans le manifeste officiel, pour
# porter ces étiquettes de sécurité.
apiVersion: v1
kind: Namespace
metadata:
  name: envoy-gateway-system
  labels:
    app.kubernetes.io/part-of: {{ k8s_cluster_name }}
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
# Le namespace de la Gateway partagée : il appartient à l'équipe qui gère
# l'infrastructure, pas aux applications. Aucun pod n'y tourne : Envoy Gateway
# crée les proxys dans son propre namespace.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ envoy_gateway_namespace }}
  labels:
    app.kubernetes.io/part-of: {{ k8s_cluster_name }}
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
