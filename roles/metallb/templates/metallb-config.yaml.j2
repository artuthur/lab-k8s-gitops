---
# {{ ansible_managed }}
#
# Configuration de MetalLB, appliquée de façon déclarative à chaque passage :
# toute modification de ce modèle est répercutée dans le cluster.
#
# Le pool : les adresses que MetalLB peut attribuer aux Services LoadBalancer.
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ metallb_pool_name }}
  namespace: metallb-system
spec:
  addresses:
    - {{ k8s_lb_address_range }}
---
# L'annonce : en mode L2, le nœud choisi pour une adresse répond aux requêtes ARP
# (« qui a cette adresse ? ») avec sa propre adresse MAC.
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ metallb_pool_name }}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ metallb_pool_name }}
  # Annoncer seulement sur le réseau privé, pas sur eth0 (NAT de Vagrant)
  interfaces:
{% for interface in metallb_l2_interfaces %}
    - {{ interface }}
{% endfor %}
